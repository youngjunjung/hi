# 복사해서 사용: cp .env.example .env && ./scripts/init-secrets.sh
# .env 는 절대 git에 커밋하지 마세요 (.gitignore에 포함됨).

# ── 직접 채울 값 ──
# Anthropic Console(https://console.anthropic.com)에서 발급
ANTHROPIC_API_KEY=
# (선택) 다른 공급자
OPENAI_API_KEY=

# Tailscale 주소: `tailscale status --json | jq -r .Self.DNSName` 결과에서 마지막 점을 뺀 값
# 예) myserver.tail1234.ts.net
TS_HOSTNAME=myserver.tail1234.ts.net
WEBUI_URL=https://${TS_HOSTNAME}
N8N_HOST=${TS_HOSTNAME}
N8N_URL=https://${TS_HOSTNAME}:8443/

TZ=Asia/Seoul

# 에이전트가 읽고 쓸 수 있는 서버 폴더 (MCP files 도구가 이 폴더만 접근)
AGENT_FILES_DIR=./data/files

# ── 아래는 scripts/init-secrets.sh 가 자동 생성 ──
POSTGRES_USER=agent
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_UI_PASSWORD=
WEBUI_SECRET_KEY=
N8N_ENCRYPTION_KEY=
MCPO_API_KEY=
